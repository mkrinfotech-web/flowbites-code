# FloBites — local env template
# Copy to `.env.local` and fill values. Never commit secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# Razorpay (optional for demo billing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_ALLOW_DEMO_WEBHOOK=1

# Resend — Auth SMTP password + Flo Circle / order / shipped emails
# Send-only keys work for SMTP + API send; they cannot list Resend domains.
RESEND_API_KEY=
# Verified domain sender (must match a Resend-verified domain)
EMAIL_FROM=FloBites <noreply@thehormonehood.com>
# Optional: https://supabase.com/dashboard/account/tokens — apply Auth SMTP via script
# SUPABASE_ACCESS_TOKEN=
